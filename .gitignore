# Secrets and personal data. See CLAUDE.md for the full rules.

# OAuth client secrets, as downloaded from the Google Cloud console.
# The downloaded file name contains the client ID, so match it by pattern.
client_secret*.json

# OAuth access and refresh tokens.
token.json

# Local configuration holding the real POP3 host and credentials.
# The placeholder copy .env.example is committed instead.
.env

# The real filter rule, which usually names real addresses.
# The placeholder copy mail_filter.example.py is committed instead.
mail_filter.py

# State file recording imported and rejected messages by UIDL.
state.txt
state.txt.tmp

# Lock file that tools/run_cron.sh holds for the length of a run.
.cron.lock

# Python bytecode, virtual environments and development tool caches.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editor and OS noise.
.DS_Store
*~

# Local Claude Code settings.
.claude/settings.local.json
