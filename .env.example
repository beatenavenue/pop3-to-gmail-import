# Copy this file to .env and fill in the real values. Do not commit .env.

# POP3 source mailbox
# See step 7 of docs/SETUP.md for what to collect.
POP3_HOST=pop.example.com
POP3_PORT=995
# Use TLS from the start of the connection (POP3S, usually port 995).
# Set this to false for a plain POP3 server on port 110, where the connection
# is upgraded with STLS instead.
POP3_TLS=true
POP3_USER=user@example.com
POP3_PASSWORD=

# Gmail destination
# Path to the OAuth client JSON downloaded in step 4 of docs/SETUP.md.
# Keep the file outside this repository. A relative path is resolved against
# the repository root.
GOOGLE_CLIENT_SECRET_FILE=/path/to/client_secret.json
# Refresh token for the Gmail account that will receive the mail.
GOOGLE_REFRESH_TOKEN=

# State file recording imported and rejected messages by UIDL. A relative path
# is resolved against the repository root.
STATE_FILE=state.txt

# Maximum number of messages handled in one run. The messages beyond it are
# left on the server and wait for the next run, so a busy mailbox is emptied
# over several runs instead of one long one. Gmail's own POP3 fetch retrieved
# at most 200 messages at a time.
MAX_MESSAGES_PER_RUN=200

# The filter rule is not configured here. Copy mail_filter.example.py to
# mail_filter.py and write the rule there.
