# Copy this file to .env and fill in the real values. Do not commit .env.

# POP3 source mailbox
# See step 7 of docs/SETUP.md for what to collect.
POP3_HOST=pop.example.com
POP3_PORT=995
# Use TLS from the start of the connection (POP3S, usually port 995).
# Set this to false for a plain POP3 server on port 110, where the connection
# is upgraded with STLS instead.
POP3_TLS=true
POP3_USER=user@example.com
POP3_PASSWORD=

# Gmail destination
# Path to the OAuth client JSON downloaded in step 4 of docs/SETUP.md.
# Keep the file outside this repository.
GOOGLE_CLIENT_SECRET_FILE=/path/to/client_secret.json
# Refresh token for the Gmail account that will receive the mail.
GOOGLE_REFRESH_TOKEN=

# The filter rule is not configured here. It lives in a separate rule file,
# so that a rule can combine more than one condition.
